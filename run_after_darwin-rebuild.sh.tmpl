#!/usr/bin/env bash

# Nag on every apply while the running system differs from nix/flake.nix.
#
# This deliberately does not activate. `darwin-rebuild switch` requires root,
# and `chezmoi apply` must not escalate: this script is rendered from repo
# content, so a sudo call here would hand root to anything that reaches the
# source tree. Activation stays an explicit, separate command.

set -euo pipefail

flake="{{ .chezmoi.sourceDir }}/nix"

command -v darwin-rebuild >/dev/null 2>&1 || exit 0

# One eval, both halves of the declared system. Deliberately not
# `system.outPath`: that embeds system.configurationRevision — the git revision
# of this whole repo — so every commit, including ones nowhere near nix/, would
# report drift that no package or /etc file reflects. system.path and
# system.build.etc carry no revision, so a difference here is a real one.
if ! declared=$(nix eval --raw "$flake#darwinConfigurations.lagrange" \
  --apply 'c: c.config.system.path.outPath + " " + c.config.system.build.etc.outPath' \
  2>/dev/null); then
  echo "nix-darwin: cannot evaluate $flake; skipping the drift check." >&2
  exit 0
fi

read -r want_sw want_etc <<<"$declared"
have_sw=$(readlink /run/current-system/sw || true)
have_etc=$(readlink /run/current-system/etc || true)

# /run/current-system/etc points one level inside the derivation.
drifted=""
if [ "$have_sw" != "$want_sw" ]; then
  drifted="packages"
fi
if [ "$have_etc" != "$want_etc/etc" ]; then
  drifted="${drifted:+$drifted and }/etc"
fi
if [ -z "$drifted" ]; then
  exit 0
fi

cat >&2 <<EOF

  nix-darwin: the running system is out of date ($drifted differ).
  Activate it when convenient:

    sudo darwin-rebuild switch --flake $flake#lagrange

EOF
