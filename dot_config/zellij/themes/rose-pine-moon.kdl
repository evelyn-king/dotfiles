// Custom Rosé Pine Moon theme for Zellij: https://rosepinetheme.com
// Zellij reads ~/.config/zellij/themes/*.kdl; `theme` in config.kdl selects it.
themes {
    rose-pine-moon {
        fg "#e0def4"
        bg "#232136"
        black "#393552"
        red "#eb6f92"
        green "#3e8fb0"
        yellow "#f6c177"
        blue "#9ccfd8"
        magenta "#c4a7e7"
        cyan "#ea9a97"
        white "#e0def4"
        orange "#f6c177"
    }
}
