{{- /* Hyprland monitor layout.

       Templated on hostname because scale factors describe the panels
       physically attached to a machine, not a preference that should follow the
       user around. A host with no branch below falls through to Omarchy's stock
       "auto" behaviour rather than inheriting another machine's numbers.

       Caveat: `omarchy hyprland monitor scaling` — what the shell's monitor
       panel and SUPER + / drive — rewrites the *rendered* file in place, so
       moving the slider shows up as chezmoi drift. Make the change stick with
       `chezmoi edit ~/.config/hypr/monitors.lua`, which opens this template. */ -}}
-- Managed by chezmoi. Edit with `chezmoi edit ~/.config/hypr/monitors.lua`.
--
-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all
{{ if eq .chezmoi.hostname "dirac" }}
-- These two lines are rewritten by `omarchy hyprland monitor scaling`, which is
-- what the shell's monitor panel and SUPER + / drive. Keep them in this exact
-- shape (`local <name> = <number>`, column 1) or the slider stops persisting.
-- It always writes here regardless of which display is focused, so treat these
-- as belonging to the EXTERNAL monitor -- see the warning below.
local omarchy_gdk_scale = 1
local omarchy_monitor_scale = 1.25

hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))

-- Catch-all: the external display (DP-2) and anything else not matched below.
-- 1.25 applies exactly on DP-2; the slider is free to retune this.
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })

-- The built-in 4k panel is unusable at fractional scaling, so pin it to 2x.
-- Deliberately a literal, not omarchy_monitor_scale: the slider must not move it.
--
-- WARNING: using the slider or SUPER + / while the LAPTOP is focused still
-- changes eDP-1 live, but persists that number into omarchy_monitor_scale
-- above, i.e. into the external's scale. If DP-2 looks wrong after docking,
-- that is why -- reset the value above and `hyprctl reload`.
hl.monitor({ output = "eDP-1", mode = "preferred", position = "auto", scale = 2 })
{{- else }}
-- No layout recorded for this host, so this is Omarchy's default: let Hyprland
-- pick the scale. Add a `{{ "{{" }} else if eq .chezmoi.hostname "..." {{ "}}" }}` branch
-- above once a machine needs something specific.
local omarchy_gdk_scale = 2
local omarchy_monitor_scale = "auto"

hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })
{{- end }}

-- Portrait/rotated secondary monitor (transform: 1 = 90°, 3 = 270°).
-- hl.monitor({ output = "DP-2", mode = "preferred", position = "auto", scale = 1, transform = 1 })
