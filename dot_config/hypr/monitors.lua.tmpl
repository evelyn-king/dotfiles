-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all

-- Keep these as plain locals: omarchy-hyprland-monitor-scaling (SUPER + SLASH)
-- rewrites both lines so a scale change survives a reboot.
{{- if eq .chezmoi.hostname "gimli" }}
local omarchy_gdk_scale = 1.6667
local omarchy_monitor_scale = 1.6667

hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))

-- LG UltraFine 5K2K.
hl.monitor({ output = "DP-3", mode = "5120x2160@120.00", position = "auto", scale = omarchy_monitor_scale })

-- Portrait/rotated secondary monitor (transform: 1 = 90°, 3 = 270°).
-- hl.monitor({ output = "DP-2", mode = "preferred", position = "auto", scale = 1 })
{{- else if eq .chezmoi.hostname "maxwell" }}
local omarchy_gdk_scale = 2
local omarchy_monitor_scale = "auto"

hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))

-- Framework 13 internal panel plus a 34" ultrawide.
hl.monitor({ output = "DP-2", mode = "3440x1440@100.00", position = "auto", scale = omarchy_monitor_scale })
hl.monitor({ output = "eDP-1", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })

-- Portrait/rotated secondary monitor (transform: 1 = 90°, 3 = 270°).
-- hl.monitor({ output = "DP-5", mode = "preferred", position = "auto", scale = 1 })
{{- else }}
-- Default to a simple 1x setup on unknown machines.
local omarchy_gdk_scale = 1
local omarchy_monitor_scale = 1

hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))

hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })
{{- end }}
