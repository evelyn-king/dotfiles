{{- /* Shared with .chezmoiignore.tmpl; edit
       .chezmoitemplates/omarchy-detect.tmpl, not this. */ -}}
{{- $omarchy := includeTemplate "omarchy-detect.tmpl" . -}}
# Ghostty config - Evelyn King

theme = "Rose Pine Moon"

# First match wins; the rest are fallbacks for hosts missing the primary font.
font-family = ""
font-family = "CaskaydiaCove Nerd Font Mono"
font-family = "FiraCode Nerd Font Mono"
font-family = "JetBrains Mono"
font-style = Regular
{{- if $omarchy }}
# Hyprland scaling
font-size = 9
{{- else }}
font-size = 12
{{- end }}

background-opacity = 1.00

# Window
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface = false
resize-overlay = never
gtk-toolbar-style = flat

# GUI launches inherit launchd cwd (/) without this. New tabs and splits still
# follow the current directory via the shell-integration path feature.
working-directory = home

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95
{{- if $omarchy }}

# Fix general slowness on hyprland
# https://github.com/ghostty-org/ghostty/discussions/3224
async-backend = epoll
{{- end }}
