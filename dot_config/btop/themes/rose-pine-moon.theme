# Rosé Pine Moon (https://rosepinetheme.com) theme for btop++
# Palette: base #232136, surface #2a273f, overlay #393552, muted #6e6a86,
#          subtle #908caa, text #e0def4, love #eb6f92, gold #f6c177,
#          rose #ea9a97, pine #3e8fb0, foam #9ccfd8, iris #c4a7e7

# Colors should be in 6 or 2 character hexadecimal or single spaced rgb decimal: "#RRGGBB", "#BW" or "0-255 0-255 0-255"
# example for white: "#FFFFFF", "#ff" or "255 255 255".

# All graphs and meters can be gradients
# For single color graphs leave "mid" and "end" variable empty.
# Use "start" and "end" variables for two color gradient
# Use "start", "mid" and "end" for three color gradient

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#232136"

# Main text color
theme[main_fg]="#e0def4"

# Title color for boxes
theme[title]="#e0def4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#eb6f92"

# Background color of selected items
theme[selected_bg]="#393552"

# Foreground color of selected items
theme[selected_fg]="#ea9a97"

# Color of inactive/disabled text
theme[inactive_fg]="#6e6a86"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#908caa"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#9ccfd8"

# Cpu box outline color
theme[cpu_box]="#44415a"

# Memory/disks box outline color
theme[mem_box]="#44415a"

# Net up/down box outline color
theme[net_box]="#44415a"

# Processes box outline color
theme[proc_box]="#44415a"

# Box divider line and small boxes line color
theme[div_line]="#44415a"

# Temperature graph colors
theme[temp_start]="#9ccfd8"
theme[temp_mid]="#f6c177"
theme[temp_end]="#eb6f92"

# CPU graph colors
theme[cpu_start]="#3e8fb0"
theme[cpu_mid]="#f6c177"
theme[cpu_end]="#eb6f92"

# Mem/Disk free meter
theme[free_start]="#eb6f92"
theme[free_mid]="#f6c177"
theme[free_end]="#3e8fb0"

# Mem/Disk cached meter
theme[cached_start]="#3e8fb0"
theme[cached_mid]="#9ccfd8"
theme[cached_end]="#c4a7e7"

# Mem/Disk available meter
theme[available_start]="#eb6f92"
theme[available_mid]="#ea9a97"
theme[available_end]="#f6c177"

# Mem/Disk used meter
theme[used_start]="#9ccfd8"
theme[used_mid]="#f6c177"
theme[used_end]="#eb6f92"

# Download graph colors
theme[download_start]="#3e8fb0"
theme[download_mid]="#9ccfd8"
theme[download_end]="#c4a7e7"

# Upload graph colors
theme[upload_start]="#eb6f92"
theme[upload_mid]="#ea9a97"
theme[upload_end]="#f6c177"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#3e8fb0"
theme[process_mid]="#c4a7e7"
theme[process_end]="#eb6f92"
