#!/usr/bin/env bash

# bat resolves custom themes from a binary cache, not from the themes directory,
# so a managed .tmTheme only takes effect after this rebuild.
# Theme hash: {{ include "dot_config/bat/themes/rose-pine-moon.tmTheme" | sha256sum }}
# Config hash: {{ include "dot_config/bat/config" | sha256sum }}
# bat executable: {{ lookPath "bat" | quote }}

set -eu

if ! command -v bat >/dev/null 2>&1; then
  echo "bat is not installed; skipping theme cache build."
else
  bat cache --build
fi
