#!/usr/bin/env bash

# Keep bat's binary cache in sync with its managed config.
# Config hash: {{ include "dot_config/bat/config" | sha256sum }}
# bat executable: {{ lookPath "bat" | quote }}

set -eu

if ! command -v bat >/dev/null 2>&1; then
  echo "bat is not installed; skipping theme cache build."
else
  bat cache --build
fi
