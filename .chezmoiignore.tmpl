{{- /* Omarchy ships its desktop into ~/.local/share/omarchy. Detect it rather
       than keying off a hostname, so a rebuilt or renamed machine needs no
       change here. */ -}}
{{- $omarchy := and
  (eq .chezmoi.os "linux")
  (ne (stat (env "OMARCHY_PATH" | default (joinPath .chezmoi.homeDir ".local/share/omarchy"))) nil)
-}}
{{- $ageIdentity := env "CHEZMOI_AGE_IDENTITY" | default (joinPath .chezmoi.homeDir ".config/chezmoi/personal-key.txt") -}}

# Repo content, not dotfiles: read from the source tree, never applied to $HOME.
AGENTS.md
CLAUDE.md
LICENSE
README.md
.mailmap
docs/**
scripts/**
nix
# mise rewrites its lock in place on every install. Applying a second copy to
# $HOME gives the two copies a way to diverge and leaves `chezmoi status`
# permanently dirty, so the source tree keeps the only copy and the locked mise
# commands point at it with MISE_CONFIG_DIR.
.config/mise/mise.lock

{{- if ne .chezmoi.os "darwin" }}
.config/aerospace
.hyprspace.toml
{{- end }}

{{- if ne .chezmoi.os "linux" }}
.config/mise/conf.d/20-linux.toml
linux-package-drift.sh
.config/superfile/**
{{- end }}

{{- if not $omarchy }}
.config/hypr/**
{{- end }}

{{- /* Optional. A machine without the age identity skips the encrypted extras
       instead of failing the whole apply. */ -}}
{{- if eq (stat $ageIdentity) nil }}
.config/shell/secrets.sh
{{- end }}
