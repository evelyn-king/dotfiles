{{- /* Detected rather than gated on a hostname, so a rebuilt or renamed
       machine needs no change here. Shared with dot_config/ghostty/config.tmpl;
       edit .chezmoitemplates/omarchy-detect.tmpl, not this. */ -}}
{{- $omarchy := includeTemplate "omarchy-detect.tmpl" . -}}

# Repo content, not dotfiles: read from the source tree, never applied to $HOME.
AGENTS.md
CLAUDE.md
LICENSE
README.md
.mailmap
docs/**
nix
# mise rewrites its lock in place on every install. Applying a second copy to
# $HOME gives the two copies a way to diverge and leaves `chezmoi status`
# permanently dirty, so the source tree keeps the only copy and the locked mise
# commands point at it with MISE_CONFIG_DIR.
.config/mise/mise.lock

{{- if ne .chezmoi.os "darwin" }}
.config/aerospace
darwin-rebuild.sh
{{- end }}

{{- if ne .chezmoi.os "linux" }}
.config/superfile/**
{{- end }}

{{- if not $omarchy }}
install-omarchy-packages.sh
.config/hypr/**
{{- end }}
