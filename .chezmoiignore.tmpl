{{- /* Detected rather than gated on a hostname, so a rebuilt or renamed
       machine needs no change here. Shared with dot_config/ghostty/config.tmpl;
       edit .chezmoitemplates/omarchy-detect.tmpl, not this. */ -}}
{{- $omarchy := includeTemplate "omarchy-detect.tmpl" . -}}
{{- $ubuntu := includeTemplate "ubuntu-detect.tmpl" . -}}

# Repo content, not dotfiles: read from the source tree, never applied to $HOME.
AGENTS.md
CLAUDE.md
LICENSE
README.md
.mailmap
docs/**
nix
# mise rewrites its lock in place on every install. Applying a second copy to
# $HOME gives the two copies a way to diverge and leaves `chezmoi status`
# permanently dirty, so the source tree keeps the only copy and the locked mise
# commands point at it with MISE_CONFIG_DIR.
.config/mise/mise.lock

{{- if not $ubuntu }}
05-bootstrap-ubuntu.sh
.config/mise/conf.d/20-ubuntu.toml
{{- else }}
# Ubuntu is a headless deployment target.
.config/ghostty/**
.config/zed/**
.claude/skills/omarchy/**
{{- end }}

{{- if ne .chezmoi.os "darwin" }}
.config/aerospace
darwin-rebuild.sh
{{- end }}

{{- if not $omarchy }}
install-omarchy-packages.sh
.config/hypr/**
{{- end }}

{{- if eq .chezmoi.os "windows" }}
# chezmoi cannot execute a bash/sh target on native Windows: there is no
# associated interpreter, so the script fails to fork/exec outright rather
# than just misbehaving. Doom Emacs and mise's tools domain are not yet
# supported on Windows; see AGENTS.md.
tool-drift.sh
mise-install.sh
trust-local-projects-mise.sh
setup-doom-emacs.sh
10-migrate-retired-configs.sh
{{- end }}
