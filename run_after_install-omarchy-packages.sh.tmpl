#!/usr/bin/env bash

# Restore packages declared in .chezmoidata/packages.yaml on every apply.
# Omarchy's package helpers skip packages that are already installed. They do
# not remove unlisted packages, so packages installed by hand remain untouched.

{{- $omarchy := includeTemplate "omarchy-detect.tmpl" . }}

set -euo pipefail

{{ if $omarchy -}}
if ! command -v omarchy >/dev/null 2>&1; then
  echo "omarchy CLI not found; skipping required package restore." >&2
  exit 0
fi

pacman_packages=(
{{- range .omarchyPackages.pacman }}
  {{ . | quote }}
{{- end }}
)

if ((${#pacman_packages[@]})); then
  # Zed depends on the virtual vulkan-driver package. Without an installed
  # provider, pacman's non-interactive default can select NVIDIA libraries on
  # unrelated hardware. The machine's graphics setup must choose the provider.
  for package in "${pacman_packages[@]}"; do
    if [[ $package == zed ]] && ! pacman -T vulkan-driver >/dev/null 2>&1; then
      cat >&2 <<'EOF'
packages: Zed requires an installed Vulkan provider before package restoration.
Choose a provider for this machine and install it with:
  omarchy pkg add <chosen-vulkan-provider>
Then rerun chezmoi apply. See docs/package-lists/omarchy-linux.md in the source tree.
EOF
      exit 1
    fi
  done

  omarchy pkg add "${pacman_packages[@]}"
fi
{{- else }}
exit 0
{{- end }}
