# macOS packages, applied with `brew bundle`.
#
# Ported from nix/flake.nix. This file is repository content, listed in
# .chezmoiignore, and is read from the source tree:
#
#   brew bundle --file "$(chezmoi source-path)/homebrew/Brewfile" --cleanup
#
# --cleanup keeps the old `cleanup = "uninstall"` behaviour: this file owns
# the Homebrew prefix, and anything it does not declare is removed.
#
# Anything managed by mise is deliberately not here, and neither is mise
# itself: run_before_00-install-mise installs the pinned release.

tap "nikitabobko/tap"
tap "omacom/mac"

