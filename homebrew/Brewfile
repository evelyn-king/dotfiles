# --- build and toolchain ----------------------------------------------------
brew "cmake"
# Homebrew installs coreutils and gawk with a "g" prefix (gls, gdate, gawk).
# Nix put the unprefixed GNU names on PATH, ahead of the BSD tools. Add
# $HOMEBREW_PREFIX/opt/{coreutils,gawk}/libexec/gnubin to PATH to keep that.
brew "coreutils"
brew "gawk"
brew "graphicsmagick"
brew "graphviz"
# libxml2 and sqlite are keg-only, because macOS ships older copies. Unlike
# under Nix, /usr/bin/xmllint and /usr/bin/sqlite3 win unless
# $HOMEBREW_PREFIX/opt/{libxml2,sqlite}/bin are added to PATH.
brew "libxml2"
brew "pkgconf"
brew "portaudio"
brew "sccache"
brew "shellcheck"
brew "sqlite"

# --- documents, data and ML -------------------------------------------------
brew "llama.cpp"
brew "pandoc"
brew "poppler"
brew "tesseract"

# --- network and misc -------------------------------------------------------
brew "awscli"
brew "chezmoi"
brew "cloudflared"
# Homebrew's gnupg defaults to the curses pinentry. GUI signing needs
#   pinentry-program /opt/homebrew/bin/pinentry-mac
# in ~/.gnupg/gpg-agent.conf.
brew "gnupg"
brew "lima"
brew "pinentry-mac"
brew "prettyping"
brew "sshpass"
brew "w3m"
brew "wget"

# Installs the App Store apps below. nix-darwin put it on the activation PATH;
# Homebrew Bundle needs it declared.
brew "mas"

# --- fonts ------------------------------------------------------------------
cask "font-caskaydia-cove-nerd-font"
cask "font-fira-code-nerd-font"
cask "font-hack-nerd-font"

# --- casks ------------------------------------------------------------------
# Casks are non-greedy, the `brew bundle` default. 36 of the 41 casks below
# set `auto_updates`. Forcing Homebrew to own every version would mean
# fighting each vendor's own updater on a roughly fortnightly cycle, and
# re-running a pkg installer under sudo for the Microsoft suite, google-drive,
# onedrive, cloudflare-warp, tailscale-app, zoom and the Logitech pair. Let
# the apps update themselves, and opt individual casks back in with
# `greedy: true`.
#
# Non-greedy upgrades still cover the five casks that do not self-update
# (aerospace, basictex, dot, omarchy). The font casks above also lack
# `auto_updates`, so ordinary upgrades cover them as well.
#
# Recount both numbers after adding or removing a cask:
#   brew info --json=v2 --cask <tokens...> \
#     | jq '[.casks[].auto_updates] | {total: length, self: map(select(.)) | length}'

# --- security and credentials ---
cask "1password"
cask "bitwarden"

# --- window management and launchers ---
# bartender and raindropio each sat between seven months and two years out of
# date while installed by hand, despite both advertising `auto_updates`.
# Non-greedy would recreate the conditions they rotted under, so Homebrew
# forces these two.
cask "nikitabobko/tap/aerospace"
cask "bartender", greedy: true
cask "raycast"

# --- browsers ---
cask "brave-origin"
cask "firefox"
cask "zen"

