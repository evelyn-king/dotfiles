#!/usr/bin/env bash

# Report Linux tool drift after chezmoi applies.
#
# Only one direction is checked here: tools mise owns that also exist as a
# hand-installed copy. System packages are Omarchy's job, not this repo's, so
# there is no declared-package check and nothing here ever calls sudo.
#
# This catches stale `uv tool` and `bun install -g` copies in user-writable
# install directories. System directories are excluded because pacman owns them
# and the managed PATH already ranks mise shims above them.

set -u

[ "$(uname -s)" = Linux ] || exit 0
command -v mise >/dev/null 2>&1 || exit 0

shims="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims"

if [ -d "$shims" ]; then
  shadows=$(
    for shim in "$shims"/*; do
      [ -f "$shim" ] && [ -x "$shim" ] || continue
      name=${shim##*/}
      managed=$(mise which "$name" 2>/dev/null || true)
      for dir in \
        "$HOME/.local/bin" \
        "$HOME/bin" \
        "$HOME/.cargo/bin" \
        "${BUN_INSTALL:-$HOME/.bun}/bin" \
        "${GOPATH:-$HOME/.local/share/go}/bin" \
        "$HOME/.local/share/npm/bin" \
        "$HOME/.npm-global/bin"; do
        [ -d "$dir" ] || continue
        candidate="$dir/$name"
        [ -f "$candidate" ] && [ -x "$candidate" ] || continue
        # Some mise backends use a standard tool-owned directory instead of
        # keeping executables below mise's install root. Rustup's proxies in
        # ~/.cargo/bin are the managed binaries, not shadow copies.
        if [ -n "$managed" ] &&
          [ "$(readlink -f "$candidate")" = "$(readlink -f "$managed")" ]; then
          continue
        fi
        printf '    %-24s %s\n' "$name" "$candidate"
      done
    done
  )

  if [ -n "$shadows" ]; then
    cat >&2 <<EOF

  mise: these tools are declared by mise but also installed by hand.
  A hand-installed copy can drift from the pinned version and may still win
  in shells that do not load the managed PATH.

$shadows

  Remove each one so mise is the only owner. Copies created by
  \`uv tool install\` or \`bun install -g\` must be removed through the tool
  that made them (\`uv tool uninstall <name>\`, \`bun remove -g <pkg>\`)
  rather than by deleting the symlink.

EOF
  fi
fi

# Reporting only: a dirty machine must not fail an otherwise good apply.
exit 0
