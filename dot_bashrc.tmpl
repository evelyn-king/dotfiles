# .bashrc - bash environment and interactive setup.
#
# Bash has no .zshenv equivalent, so this file carries both halves: the shared
# environment runs unconditionally, and everything past the interactive guard
# matches what ~/.zshrc does. Edit the shared bodies in .chezmoitemplates/,
# not here.

{{ template "shell-env.sh" . }}

# Nothing below this line applies to non-interactive shells.
case $- in
*i*) ;;
*) return ;;
esac

# --- zsh handoff ------------------------------------------------------------

# zsh is the daily shell; bash is what a stray terminal, a login prompt or a
# recovery shell lands in. Hand over once, and only once, so those all end up
# with the same environment. Set SHELL_PREFER_ZSH=0 before starting bash to
# stay put. __SHELL_ZSH_HANDOFF guards against a loop if zsh is broken.
if [ "${SHELL_PREFER_ZSH:-1}" = 1 ] &&
  [ -z "${ZSH_VERSION:-}" ] &&
  [ -z "${__SHELL_ZSH_HANDOFF:-}" ] &&
  command -v zsh >/dev/null 2>&1; then
  __zsh=$(command -v zsh)
  export __SHELL_ZSH_HANDOFF=1
  exec env SHELL="$__zsh" "$__zsh"
fi

{{ template "shell-path.sh" . }}

# --- history ----------------------------------------------------------------

# zsh needs no equivalent block: atuin owns history in both shells, but bash's
# defaults truncate and overwrite badly enough to matter before atuin loads.
HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth
shopt -s histappend checkwinsize

# --- completions ------------------------------------------------------------

if ! shopt -oq posix; then
  for __bc in \
    /usr/share/bash-completion/bash_completion \
    /etc/bash_completion \
    /opt/homebrew/etc/profile.d/bash_completion.sh \
    /usr/local/etc/profile.d/bash_completion.sh; do
    if [ -r "$__bc" ]; then
      . "$__bc"
      break
    fi
  done
  unset __bc
fi

export BASH_COMPLETION_USER_DIR="$XDG_DATA_HOME/bash-completion"

# --- preexec ----------------------------------------------------------------

# bash has no preexec/precmd. atuin's bash integration needs them, so this must
# be sourced before shell-interactive.sh runs `atuin init bash`. zsh needs no
# equivalent. The vendored copy is ~/.bash-preexec.sh, tracked in this repo.
[ -f "$HOME/.bash-preexec.sh" ] && . "$HOME/.bash-preexec.sh"

{{ template "shell-interactive.sh" . }}
