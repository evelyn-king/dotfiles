#!/usr/bin/env bash

set -euo pipefail

SCRIPT_NAME="install-micromamba-env"

usage() {
  cat <<EOF
Usage: ${SCRIPT_NAME} <environment.yml> [more environment files...]

Refresh each micromamba environment from its YAML file. The script builds and
tests a staging environment before replacing an existing environment. It also
stages the Jupyter kernel and restores the old environment and kernel if the
replacement fails.

Environment:
  MAMBA_ROOT_PREFIX  Micromamba root prefix. Defaults to the chezmoi host config.
EOF
}

log() {
  printf '[%s] %s\n' "${SCRIPT_NAME}" "$*"
}

die() {
  printf '[%s] %s\n' "${SCRIPT_NAME}" "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

default_mamba_root_prefix() {
  # MAMBA_ROOT_PREFIX is exported by shell startup (shell-env.sh) with this same
  # default. Repeated here so the script also works when invoked from an
  # environment that never ran it.
  printf '%s\n' "${MAMBA_ROOT_PREFIX:-${HOME}/.local/opt/micromamba}"
}

env_name_from_file() {
  local env_file="$1"
  local env_name

  env_name="$(
    awk '
      /^[[:space:]]*name:[[:space:]]*/ {
        sub(/^[[:space:]]*name:[[:space:]]*/, "", $0)
        sub(/[[:space:]]*(#.*)?$/, "", $0)
        print
        exit
      }
    ' "$env_file"
  )"

  [ -n "${env_name}" ] || die "Could not determine environment name from ${env_file}"
  case "$env_name" in
    . | .. | *[!A-Za-z0-9_.-]*)
      die "Unsupported environment name in ${env_file}: ${env_name}"
      ;;
  esac
  printf '%s\n' "${env_name}"
}

smoke_test_env() {
  local prefix="$1"

  "${MICROMAMBA[@]}" run -p "$prefix" python -c \
    'import ipykernel; print(ipykernel.__version__)' >/dev/null
}

reset_refresh_state() {
  STAGING_DIR=
  FINAL_PREFIX=
  ENV_BACKUP=
  ENV_BACKED_UP=0
  FINAL_REPLACED=0
  KERNEL_STAGING_DIR=
  KERNEL_DIR=
  KERNEL_BACKUP=
  KERNEL_BACKED_UP=0
  KERNEL_REPLACED=0
}

cleanup_refresh() {
  local status=$?

  trap - EXIT HUP INT TERM
  set +e

  if [ "$KERNEL_BACKED_UP" -eq 1 ]; then
    rm -rf -- "$KERNEL_DIR"
    mv -- "$KERNEL_BACKUP" "$KERNEL_DIR"
  elif [ "$KERNEL_REPLACED" -eq 1 ]; then
    rm -rf -- "$KERNEL_DIR"
  fi

  if [ "$ENV_BACKED_UP" -eq 1 ]; then
    rm -rf -- "$FINAL_PREFIX"
    mv -- "$ENV_BACKUP" "$FINAL_PREFIX"
  elif [ "$FINAL_REPLACED" -eq 1 ]; then
    rm -rf -- "$FINAL_PREFIX"
  fi

  [ -n "$KERNEL_STAGING_DIR" ] && rm -rf -- "$KERNEL_STAGING_DIR"
  [ -n "$STAGING_DIR" ] && rm -rf -- "$STAGING_DIR"
  exit "$status"
}

finish_refresh() {
  local staging_dir="$STAGING_DIR"
  local env_backup="$ENV_BACKUP"
  local kernel_staging_dir="$KERNEL_STAGING_DIR"
  local kernel_backup="$KERNEL_BACKUP"

  # The new environment and kernel are now usable. Clear rollback state before
  # deleting backups so an interrupted cleanup cannot remove the replacement.
  reset_refresh_state
  [ -n "$kernel_backup" ] && rm -rf -- "$kernel_backup"
  [ -n "$env_backup" ] && rm -rf -- "$env_backup"
  [ -n "$kernel_staging_dir" ] && rm -rf -- "$kernel_staging_dir"
  [ -n "$staging_dir" ] && rm -rf -- "$staging_dir"
}

refresh_env() {
  local env_file="$1"
  local env_name="$2"
  local staging_prefix
  local kernel_data_dir
  local kernel_root
  local kernel_staging_prefix
  local kernel_candidate

  reset_refresh_state
  FINAL_PREFIX="$ENV_ROOT/$env_name"
  ENV_BACKUP="$ENV_ROOT/.${env_name}.backup.$$"

  STAGING_DIR=$(mktemp -d "$ENV_ROOT/.${env_name}.staging.XXXXXX")
  staging_prefix="$STAGING_DIR/prefix"

  log "Building staging environment ${env_name} from ${env_file}"
  "${MICROMAMBA[@]}" env create -p "$staging_prefix" -f "$env_file" -y
  smoke_test_env "$staging_prefix"

  if [ -e "$FINAL_PREFIX" ] || [ -L "$FINAL_PREFIX" ]; then
    [ -d "$FINAL_PREFIX/conda-meta" ] ||
      die "Refusing to replace non-environment path: ${FINAL_PREFIX}"
    [ ! -e "$ENV_BACKUP" ] && [ ! -L "$ENV_BACKUP" ] ||
      die "Environment backup path already exists: ${ENV_BACKUP}"
    mv -- "$FINAL_PREFIX" "$ENV_BACKUP"
    ENV_BACKED_UP=1
  fi

  # Recreate at the final prefix so packages with embedded paths are not moved
  # after installation. The staging build has already solved, downloaded,
  # extracted, installed pip dependencies, and passed the smoke test.
  FINAL_REPLACED=1
  log "Creating replacement environment ${env_name}"
  "${MICROMAMBA[@]}" env create -p "$FINAL_PREFIX" -f "$env_file" -y
  smoke_test_env "$FINAL_PREFIX"

  kernel_data_dir=$("${MICROMAMBA[@]}" run -p "$FINAL_PREFIX" jupyter --data-dir)
  case "$kernel_data_dir" in
    /*) ;;
    *) die "Jupyter returned a non-absolute data directory: ${kernel_data_dir}" ;;
  esac

  kernel_root="${kernel_data_dir%/}/kernels"
  mkdir -p "$kernel_root"
  KERNEL_DIR="$kernel_root/$env_name"
  KERNEL_BACKUP="$kernel_root/.${env_name}.backup.$$"
  KERNEL_STAGING_DIR=$(mktemp -d "$kernel_root/.${env_name}.staging.XXXXXX")
  kernel_staging_prefix="$KERNEL_STAGING_DIR/prefix"
  mkdir -p "$kernel_staging_prefix"

  log "Staging kernel ${env_name}"
  "${MICROMAMBA[@]}" run -p "$FINAL_PREFIX" python -m ipykernel install \
    --prefix "$kernel_staging_prefix" \
    --name "$env_name" \
    --display-name "Python (${env_name})"
  kernel_candidate="$kernel_staging_prefix/share/jupyter/kernels/$env_name"
  [ -d "$kernel_candidate" ] || die "Staged kernel was not created: ${env_name}"

  if [ -e "$KERNEL_DIR" ] || [ -L "$KERNEL_DIR" ]; then
    [ ! -e "$KERNEL_BACKUP" ] && [ ! -L "$KERNEL_BACKUP" ] ||
      die "Kernel backup path already exists: ${KERNEL_BACKUP}"
    mv -- "$KERNEL_DIR" "$KERNEL_BACKUP"
    KERNEL_BACKED_UP=1
  fi
  KERNEL_REPLACED=1
  mv -- "$kernel_candidate" "$KERNEL_DIR"

  log "Installed environment and kernel ${env_name}"
  finish_refresh
}

if [ "$#" -eq 0 ]; then
  usage >&2
  exit 1
fi

ENV_FILES=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    *)
      ENV_FILES+=("$1")
      shift
      ;;
  esac
done

require_command micromamba

MAMBA_ROOT_PREFIX="${MAMBA_ROOT_PREFIX:-$(default_mamba_root_prefix)}"
export MAMBA_ROOT_PREFIX
readonly MAMBA_ROOT_PREFIX
readonly MICROMAMBA=(micromamba --root-prefix "${MAMBA_ROOT_PREFIX}")
readonly ENV_ROOT="$MAMBA_ROOT_PREFIX/envs"

for env_file in "${ENV_FILES[@]}"; do
  [ -f "${env_file}" ] || die "Environment file not found: ${env_file}"
done

mkdir -p "$ENV_ROOT"
reset_refresh_state
trap cleanup_refresh EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

for env_file in "${ENV_FILES[@]}"; do
  env_name="$(env_name_from_file "${env_file}")"
  refresh_env "$env_file" "$env_name"
done
