#!/usr/bin/env bash

set -euo pipefail
umask 077

SCRIPT_NAME="jupyter-remote-lab"
PORT="${JUPYTER_PORT:-8888}"
ENV_NAME="${JUPYTER_ENV_NAME:-jupyter}"
BIND_HOST="${JUPYTER_BIND_HOST:-127.0.0.1}"
NOTEBOOK_DIR="${JUPYTER_NOTEBOOK_DIR:-$PWD}"
STATE_DIR="${JUPYTER_STATE_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}/jupyter-remote}"
DETACH=0
TOKEN_MODE="default"
TOKEN_SOURCE_FILE=""
STARTUP_TIMEOUT="${JUPYTER_STARTUP_TIMEOUT:-30}"
EXTRA_ARGS=()

usage() {
  cat <<EOF
Usage: ${SCRIPT_NAME} [options] [-- <extra jupyter args>]

Launch a headless JupyterLab server bound to localhost for SSH port forwarding.
The lab process runs inside the selected conda/micromamba environment.

Options:
  --port PORT        Remote port to bind. Defaults to \$JUPYTER_PORT or 8888.
  --env NAME         Conda/micromamba environment. Defaults to \$JUPYTER_ENV_NAME or jupyter.
  --bind-host HOST   Bind address. Defaults to \$JUPYTER_BIND_HOST or 127.0.0.1.
  --dir PATH         Notebook root directory. Defaults to \$JUPYTER_NOTEBOOK_DIR or the current directory.
  --detach           Start JupyterLab in the background with a log and pid file.
  --token-file PATH  Read an explicit Jupyter token from a file.
  --no-token         Disable token auth. Only do this if localhost binding is sufficient for your threat model.
  -h, --help         Show this help message.

Environment:
  JUPYTER_BIND_HOST       Default bind host.
  JUPYTER_ENV_NAME        Default environment name.
  JUPYTER_NOTEBOOK_DIR    Default notebook directory.
  JUPYTER_PORT            Default remote port.
  JUPYTER_REMOTE_ENV_FILE Runtime env file written for later sourcing.
  JUPYTER_STARTUP_TIMEOUT Seconds to wait for a detached server. Defaults to 30.
  JUPYTER_STATE_DIR       State directory for runtime metadata.

Examples:
  ${SCRIPT_NAME}
  ${SCRIPT_NAME} --detach --port 8899 --dir ~/work/project
  ssh -N -L 8899:127.0.0.1:8899 <ssh-host>
EOF
}

log() {
  printf '[%s] %s\n' "${SCRIPT_NAME}" "$*"
}

die() {
  printf '[%s] %s\n' "${SCRIPT_NAME}" "$*" >&2
  exit 1
}

require_value() {
  [ "$#" -ge 2 ] || die "Missing value for $1"
}

shell_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

validate_port() {
  case "$1" in
    ''|*[!0-9]*)
      return 1
      ;;
  esac

  [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

default_mamba_root_prefix() {
  # MAMBA_ROOT_PREFIX is exported by shell startup (shell-env.sh) with this same
  # default. Repeated here so the script also works when invoked from an
  # environment that never ran it.
  printf '%s\n' "${MAMBA_ROOT_PREFIX:-${HOME}/.local/opt/micromamba}"
}

resolve_env_runner() {
  local mamba_root_prefix

  if [ -z "${MAMBA_ROOT_PREFIX:-}" ]; then
    mamba_root_prefix="$(default_mamba_root_prefix)"
    if [ -n "${mamba_root_prefix}" ]; then
      export MAMBA_ROOT_PREFIX="${mamba_root_prefix}"
    fi
  fi

  if [ -n "${MAMBA_EXE:-}" ] && [ -x "${MAMBA_EXE}" ]; then
    ENV_RUNNER=("${MAMBA_EXE}" run -n "${ENV_NAME}")
    return 0
  fi

  if command -v micromamba >/dev/null 2>&1; then
    ENV_RUNNER=(micromamba run -n "${ENV_NAME}")
    return 0
  fi

  if command -v conda >/dev/null 2>&1; then
    ENV_RUNNER=(conda run --no-capture-output -n "${ENV_NAME}")
    return 0
  fi

  die "Missing required command: micromamba or conda"
}

prepare_state() {
  local runtime_parent

  LOG_FILE="${STATE_DIR}/jupyter-${PORT}.log"
  PID_FILE="${STATE_DIR}/jupyter-${PORT}.pid"
  TOKEN_FILE="${STATE_DIR}/jupyter-${PORT}.token"
  RUNTIME_ENV_FILE="${JUPYTER_REMOTE_ENV_FILE:-${STATE_DIR}/current.env}"
  runtime_parent="$(dirname "${RUNTIME_ENV_FILE}")"

  mkdir -p "${STATE_DIR}" "${runtime_parent}"
  chmod 700 "${STATE_DIR}"
}

configure_token() {
  case "${TOKEN_MODE}" in
    custom)
      [ -f "${TOKEN_SOURCE_FILE}" ] || die "Token file not found: ${TOKEN_SOURCE_FILE}"
      [ -r "${TOKEN_SOURCE_FILE}" ] || die "Token file is not readable: ${TOKEN_SOURCE_FILE}"
      if [ "${TOKEN_SOURCE_FILE}" != "${TOKEN_FILE}" ]; then
        install -m 600 "${TOKEN_SOURCE_FILE}" "${TOKEN_FILE}"
      else
        chmod 600 "${TOKEN_FILE}"
      fi
      unset JUPYTER_TOKEN
      export JUPYTER_TOKEN_FILE="${TOKEN_FILE}"
      ;;
    none)
      rm -f "${TOKEN_FILE}"
      unset JUPYTER_TOKEN_FILE
      export JUPYTER_TOKEN=""
      ;;
    default)
      ;;
  esac
}

port_is_ready() {
  local probe_host="${BIND_HOST}"

  case "${probe_host}" in
    0.0.0.0)
      probe_host="127.0.0.1"
      ;;
    ::)
      probe_host="::1"
      ;;
  esac

  (exec 3<>"/dev/tcp/${probe_host}/${PORT}") >/dev/null 2>&1
}

show_startup_log() {
  if [ -s "${LOG_FILE}" ]; then
    echo "${SCRIPT_NAME}: last startup log lines:" >&2
    tail -n 20 "${LOG_FILE}" >&2
  fi
}

wait_for_detached_start() {
  local child_pid="$1" deadline=$((SECONDS + STARTUP_TIMEOUT)) child_status

  while [ "${SECONDS}" -lt "${deadline}" ]; do
    if ! kill -0 "${child_pid}" 2>/dev/null; then
      child_status=0
      wait "${child_pid}" || child_status=$?
      echo "${SCRIPT_NAME}: JupyterLab exited during startup with status ${child_status}." >&2
      show_startup_log
      return 1
    fi
    if port_is_ready; then
      return 0
    fi
    sleep 0.25
  done

  echo "${SCRIPT_NAME}: JupyterLab did not open ${BIND_HOST}:${PORT} within ${STARTUP_TIMEOUT} seconds." >&2
  kill "${child_pid}" 2>/dev/null || true
  wait "${child_pid}" 2>/dev/null || true
  show_startup_log
  return 1
}

write_runtime_env() {
  local remote_host remote_url remote_pid="" tmp_env_file

  tmp_env_file="${RUNTIME_ENV_FILE}.tmp"
  remote_host="$(hostname -f 2>/dev/null || hostname)"
  remote_url="http://${BIND_HOST}:${PORT}/lab"

  if [ "${DETACH}" = "1" ] && [ -f "${PID_FILE}" ]; then
    remote_pid="$(tr -d '[:space:]' < "${PID_FILE}")"
  fi

  install -m 600 /dev/null "${tmp_env_file}"

  {
    printf 'export JUPYTER_BIND_HOST=%s\n' "$(shell_quote "${BIND_HOST}")"
    printf 'export JUPYTER_ENV_NAME=%s\n' "$(shell_quote "${ENV_NAME}")"
    printf 'export JUPYTER_NOTEBOOK_DIR=%s\n' "$(shell_quote "${NOTEBOOK_DIR}")"
    printf 'export JUPYTER_PORT=%s\n' "$(shell_quote "${PORT}")"
    printf 'export JUPYTER_REMOTE_ENV_FILE=%s\n' "$(shell_quote "${RUNTIME_ENV_FILE}")"
    printf 'export JUPYTER_REMOTE_HOST=%s\n' "$(shell_quote "${remote_host}")"
    printf 'export JUPYTER_REMOTE_LOG_FILE=%s\n' "$(shell_quote "${LOG_FILE}")"
    printf 'export JUPYTER_REMOTE_PID_FILE=%s\n' "$(shell_quote "${PID_FILE}")"
    printf 'export JUPYTER_REMOTE_URL=%s\n' "$(shell_quote "${remote_url}")"
    printf 'export JUPYTER_STATE_DIR=%s\n' "$(shell_quote "${STATE_DIR}")"
    if [ "${TOKEN_MODE}" = "custom" ]; then
      printf 'export JUPYTER_REMOTE_TOKEN_FILE=%s\n' "$(shell_quote "${TOKEN_FILE}")"
    fi
    if [ -n "${remote_pid}" ]; then
      printf 'export JUPYTER_REMOTE_PID=%s\n' "$(shell_quote "${remote_pid}")"
    fi
  } > "${tmp_env_file}"

  mv "${tmp_env_file}" "${RUNTIME_ENV_FILE}"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --port)
      require_value "$@"
      PORT="$2"
      shift 2
      ;;
    --port=*)
      PORT="${1#*=}"
      shift
      ;;
    --env)
      require_value "$@"
      ENV_NAME="$2"
      shift 2
      ;;
    --env=*)
      ENV_NAME="${1#*=}"
      shift
      ;;
    --bind-host|--host|--ip)
      require_value "$@"
      BIND_HOST="$2"
      shift 2
      ;;
    --bind-host=*|--host=*|--ip=*)
      BIND_HOST="${1#*=}"
      shift
      ;;
    --dir|--notebook-dir|--root-dir)
      require_value "$@"
      NOTEBOOK_DIR="$2"
      shift 2
      ;;
    --dir=*|--notebook-dir=*|--root-dir=*)
      NOTEBOOK_DIR="${1#*=}"
      shift
      ;;
    --detach)
      DETACH=1
      shift
      ;;
    --token-file)
      require_value "$@"
      TOKEN_MODE="custom"
      TOKEN_SOURCE_FILE="$2"
      shift 2
      ;;
    --token-file=*)
      TOKEN_MODE="custom"
      TOKEN_SOURCE_FILE="${1#*=}"
      shift
      ;;
    --token|--token=*)
      die "--token exposes the token in process arguments; use --token-file instead"
      ;;
    --no-token)
      TOKEN_MODE="none"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      EXTRA_ARGS=("$@")
      break
      ;;
    *)
      die "Unknown argument: $1"
      ;;
  esac
done

validate_port "${PORT}" || die "Invalid port: ${PORT}"
validate_port "${STARTUP_TIMEOUT}" || die "Invalid startup timeout: ${STARTUP_TIMEOUT}"
[ -d "${NOTEBOOK_DIR}" ] || die "Notebook directory not found: ${NOTEBOOK_DIR}"
NOTEBOOK_DIR="$(cd "${NOTEBOOK_DIR}" && pwd)"

export JUPYTER_BIND_HOST="${BIND_HOST}"
export JUPYTER_ENV_NAME="${ENV_NAME}"
export JUPYTER_NOTEBOOK_DIR="${NOTEBOOK_DIR}"
export JUPYTER_PORT="${PORT}"
export JUPYTER_STATE_DIR="${STATE_DIR}"

resolve_env_runner
if ! "${ENV_RUNNER[@]}" jupyter --version >/dev/null; then
  die "Environment ${ENV_NAME} is missing or does not contain Jupyter"
fi

prepare_state
if port_is_ready; then
  die "Port ${PORT} is already accepting connections on ${BIND_HOST}"
fi
configure_token

JUPYTER_CMD=(
  jupyter lab
  --no-browser
  --ServerApp.ip="${BIND_HOST}"
  --ServerApp.port="${PORT}"
  --ServerApp.port_retries=0
  --ServerApp.root_dir="${NOTEBOOK_DIR}"
)

if [ "${#EXTRA_ARGS[@]}" -gt 0 ]; then
  JUPYTER_CMD+=("${EXTRA_ARGS[@]}")
fi

if [ "${DETACH}" = "1" ]; then
  install -m 600 /dev/null "${LOG_FILE}"
  rm -f "${PID_FILE}"
  nohup "${ENV_RUNNER[@]}" "${JUPYTER_CMD[@]}" >"${LOG_FILE}" 2>&1 </dev/null &
  child_pid=$!
  if ! wait_for_detached_start "${child_pid}"; then
    rm -f "${PID_FILE}"
    if [ "${TOKEN_MODE}" = "custom" ]; then
      rm -f "${TOKEN_FILE}"
    fi
    exit 1
  fi
  printf '%s\n' "${child_pid}" >"${PID_FILE}"
  chmod 600 "${PID_FILE}"
  write_runtime_env

  log "Started JupyterLab on ${BIND_HOST}:${PORT}"
  log "Environment: ${ENV_NAME}"
  log "Runtime env file: ${RUNTIME_ENV_FILE}"
  log "Log file: ${LOG_FILE}"
  log "PID file: ${PID_FILE}"
  log "Tunnel from your laptop with: ssh -N -L ${PORT}:127.0.0.1:${PORT} <ssh-host>"
  if [ "${TOKEN_MODE}" = "default" ]; then
    log "Use the startup URL from the log file once Jupyter finishes booting."
  fi
  exit 0
fi

write_runtime_env

log "Starting JupyterLab on ${BIND_HOST}:${PORT}"
log "Environment: ${ENV_NAME}"
log "Runtime env file: ${RUNTIME_ENV_FILE}"
log "Tunnel from your laptop with: ssh -N -L ${PORT}:127.0.0.1:${PORT} <ssh-host>"
if [ "${TOKEN_MODE}" = "default" ]; then
  log "Jupyter will print its tokenized URL after startup."
fi

exec "${ENV_RUNNER[@]}" "${JUPYTER_CMD[@]}"
