#!/usr/bin/env bash

# Report tool ownership drift on request. This script only reports;
# it never removes a tool or changes the active system.

set -u

printf '%s\n' 'dotfiles-doctor: checking tool ownership and system drift' \
  'This command reports findings without installing or removing anything.'

check() { printf '\nCHECK %s\n' "$*"; }
ok() { printf '  OK   %s\n' "$*"; }
skip() { printf '  SKIP %s\n' "$*"; }

{{- $omarchy := includeTemplate "omarchy-detect.tmpl" . }}
{{ if $omarchy }}
is_stock_omarchy_launcher() {
  # Audited Omarchy 4.0.2 launchers. Match the location and complete contents;
  # modified launchers and other executables must still be reported.
  [ "$1" = "$HOME/.local/bin/$2" ] && [ ! -L "$1" ] || return 1
  case "$2" in
    claude | codex | gemini | gh | opencode | pi) ;;
    *) return 1 ;;
  esac
  cmp -s "$1" <(printf '#!/bin/bash\nexport MISE_MINIMUM_RELEASE_AGE=0\nmise use -g --quiet "%s" || exit 1\nexec mise x "%s" -- "%s" "$@"\n' "$2" "$2" "$2")
}
{{ end }}

# The pinned release from run_before_00-install-mise. Call it by path so a
# command from a shell that predates ~/.local/bin still reports against it.
mise="$HOME/.local/bin/mise"

check 'Pinned mise on PATH'
if [ -x "$mise" ]; then
  # Omarchy's /usr/bin/mise stays installed, and macOS keeps the Nix copy until
  # the generation that drops it is active. Both are fine as long as the pinned
  # binary wins. `type -P` skips the shell function `mise activate` defines.
  resolved=$(type -P mise 2>/dev/null || true)
  if [ -n "$resolved" ] && [ "$resolved" != "$mise" ]; then
    cat >&2 <<EOF

  WARN mise: \`mise\` resolves to $resolved rather than the pinned $mise.
  Check that ~/.local/bin precedes it on PATH in a fresh login shell.

EOF
  elif [ -z "$resolved" ]; then
    printf '  WARN mise is installed at %s but is missing from PATH.\n' "$mise" >&2
  else
    ok "mise resolves to $mise"
  fi

  check 'Duplicate manual installations of mise tools'
  shims="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims"

  if [ -d "$shims" ]; then
    shadows=$(
      for shim in "$shims"/*; do
        [ -f "$shim" ] && [ -x "$shim" ] || continue
        name=${shim##*/}
        managed=$("$mise" which "$name" 2>/dev/null || true)
        [ -n "$managed" ] || continue
        for dir in \
          "$HOME/.local/bin" \
          "$HOME/bin" \
          "$HOME/.cargo/bin" \
          "${BUN_INSTALL:-$HOME/.bun}/bin" \
          "${GOPATH:-$HOME/.local/share/go}/bin" \
          "$HOME/.local/share/npm/bin" \
          "$HOME/.npm-global/bin"; do
          [ -d "$dir" ] || continue
          candidate="$dir/$name"
          [ -f "$candidate" ] && [ -x "$candidate" ] || continue
          # Rustup proxies and similar backends can place the managed binary in
          # a standard tool-owned directory. Do not report the same file twice.
          if [ "$candidate" -ef "$managed" ]; then
            continue
          fi
{{ if $omarchy }}
          if is_stock_omarchy_launcher "$candidate" "$name"; then
            continue
          fi
{{ end }}
          printf '    %-24s %s\n' "$name" "$candidate"
        done
      done
    )

    if [ -n "$shadows" ]; then
      cat >&2 <<EOF

  WARN mise: these tools are declared by mise but also installed by hand.
  A hand-installed copy can drift from the locked version and may still win
  in shells that do not load the managed PATH.

$shadows

  Remove each one through the tool that installed it. For example, use
  \`uv tool uninstall <name>\` or \`bun remove -g <package>\` instead of
  deleting a symlink by hand.

EOF
    else
      ok 'No duplicate manual installations found in the checked tool directories.'
    fi
  else
    skip "Shim directory is absent: $shims"
  fi

  # Global config can select a newer installed release for "latest" while the
  # apply hook still installs an older locked version. Keep every locked pair.
  # Read the current source lock, including updates made by mup since apply.
  check 'Unused mise versions, excluding the current source lock'
  source_dir={{ .chezmoi.sourceDir | quote }}
  if ! locked=$(chezmoi --source "$source_dir" execute-template \
    --file "$source_dir/.chezmoitemplates/mise-locked-tools.tmpl"); then
    echo "  ERROR cannot read the source lock; unused versions are unknown." >&2
    exit 1
  fi
  if ! installed_prunable=$("$mise" ls --prunable --no-header); then
    echo '  ERROR mise could not list unused versions; this check is incomplete.' >&2
    exit 1
  fi
  prunable=$(
    printf '%s\n' "$installed_prunable" |
      while read -r tool version rest; do
        [ -n "$tool" ] && [ -n "$version" ] || continue
        printf '%s\n' "$locked" | grep -Fxq -- "$tool:$version" && continue
        printf '    %s@%s\n' "$tool" "$version"
      done
  )
  if [ -n "$prunable" ]; then
    cat >&2 <<EOF

  WARN mise: these installed versions are unused by tracked config and the source lock:

$prunable

  Review them, then remove individual entries with \`mise uninstall <tool>@<version>\`.
  Avoid a blanket \`mise prune --tools\`: it does not account for the source lock.

EOF
  else
    ok 'No unused versions outside the source lock found.'
  fi
else
  skip "Pinned mise is absent: $mise. Run chezmoi apply to install it."
  skip 'Duplicate installation and unused version checks require pinned mise.'
fi

{{- if eq .chezmoi.os "darwin" }}
check 'nix-darwin commands shadowed on PATH'
system_bin=/run/current-system/sw/bin
if [ -d "$system_bin" ]; then
  system_shadows=$(
    for candidate in "$system_bin"/*; do
      [ -f "$candidate" ] && [ -x "$candidate" ] || continue
      name=${candidate##*/}
      resolved=$(command -v "$name" 2>/dev/null || true)
      case "$resolved" in
        (/*) ;;
        (*) continue ;;
      esac
      [ "$resolved" = "$candidate" ] || printf '    %-24s %s\n' "$name" "$resolved"
    done
  )

  if [ -n "$system_shadows" ]; then
    cat >&2 <<EOF

  WARN nix-darwin: these system commands are shadowed earlier on PATH:

$system_shadows

  Remove the earlier copy or change its package ownership. The system command
  remains available under $system_bin.

EOF
  else
    ok 'No nix-darwin commands are shadowed on PATH.'
  fi
else
  skip "System command directory is absent: $system_bin"
fi
{{- end }}

{{ if eq .chezmoi.os "darwin" }}
# Compare the active system without activating or installing anything.
check 'Active nix-darwin generation against the source flake'
(
set -euo pipefail

flake={{ printf "%s/nix" .chezmoi.sourceDir | quote }}

if ! command -v darwin-rebuild >/dev/null 2>&1; then
  skip 'darwin-rebuild is not on PATH; active generation comparison is unavailable.'
  exit 0
fi

if [ ! -r /run/current-system/activate ]; then
  cat >&2 <<EOF

  WARN nix-darwin: no active generation exists yet.
  Create the first generation with:

    sudo darwin-rebuild switch --flake $flake#macbook

EOF
  exit 0
fi

# Compare the independently linked build outputs plus the activation script.
# Deliberately do not compare `system.outPath`: it embeds
# system.configurationRevision, the git revision of this whole repo, so every
# commit would report drift even when nix/ did not change.
if ! declared=$(nix eval --raw "$flake#darwinConfigurations.macbook" \
  --apply 'c: let cfg = c.config; in
    cfg.system.path.outPath + " " +
    cfg.system.build.etc.outPath + " " +
    cfg.system.build.applications.outPath + " " +
    cfg.system.build.fonts.outPath + " " +
    cfg.system.build.launchd.outPath + " " +
    cfg.system.build.patches.outPath + " " +
    builtins.hashString "sha256" cfg.system.activationScripts.script.text'); then
  echo "  ERROR nix-darwin: failed to evaluate $flake; drift is unknown." >&2
  exit 1
fi

read -r want_sw want_etc want_apps want_fonts want_launchd want_patches want_activate <<<"$declared"
have_sw=$(readlink /run/current-system/sw || true)
have_etc=$(readlink /run/current-system/etc || true)
have_apps=$(readlink /run/current-system/Applications || true)
have_fonts=$(readlink /run/current-system/Library/Fonts || true)
have_launchd=$(readlink /run/current-system/Library/LaunchAgents || true)
have_patches=$(readlink /run/current-system/patches || true)

# The built script replaces @out@ with its own generation path and gains one
# trailing blank line. Normalize only those generated differences.
have_activate=$(
  sed -e 's|^systemConfig=.*$|systemConfig=@out@|' -e '${/^$/d;}' \
    /run/current-system/activate |
    shasum -a 256
)
have_activate=${have_activate%% *}

drifted=""
add_drift() {
  drifted="${drifted:+$drifted, }$1"
}

if [ "$have_sw" != "$want_sw" ]; then
  add_drift packages
fi
if [ "$have_etc" != "$want_etc/etc" ]; then
  add_drift /etc
fi
if [ "$have_apps" != "$want_apps/Applications" ]; then
  add_drift applications
fi
if [ "$have_fonts" != "$want_fonts/Library/Fonts" ]; then
  add_drift fonts
fi
if [ "$have_launchd" != "$want_launchd/Library/LaunchAgents" ]; then
  add_drift launchd
fi
if [ "$have_patches" != "$want_patches/patches" ]; then
  add_drift patches
fi
if [ "$have_activate" != "$want_activate" ]; then
  add_drift activation
fi
if [ -z "$drifted" ]; then
  ok 'The active generation matches the flake across all seven checked components.'
  exit 0
fi

cat >&2 <<EOF

  WARN nix-darwin: the running system differs in $drifted.
  Activate it when convenient:

    sudo darwin-rebuild switch --flake $flake#macbook

EOF
)
result=$?
if [ "$result" -ne 0 ]; then
  echo 'dotfiles-doctor: system comparison failed; checks are incomplete.' >&2
  exit "$result"
fi
{{ else }}
skip 'nix-darwin checks apply only to macOS.'
{{ end }}
printf '\ndotfiles-doctor: finished. Review any WARN or SKIP messages above.\n'
