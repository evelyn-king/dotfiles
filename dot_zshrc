# .zshrc - interactive zsh.
#
# PATH is built here rather than in .zshenv because macOS /etc/zprofile runs
# path_helper in between, which would reorder earlier prepends.

typeset -U path fpath

# --- PATH -------------------------------------------------------------------

# (N-/) drops entries that aren't existing directories.
#
# The Nix profiles are named explicitly so their order is set here rather than
# inherited from /etc/zshenv. `typeset -U` keeps the first occurrence of a
# duplicate, so listing them is what fixes their position.
path=(
  # Not (N-/): the first `go install` creates it.
  "$GOPATH/bin"
  "$HOME/.local/bin"(N-/)
  "$HOME/.cargo/bin"(N-/)
  "$BUN_INSTALL/bin"(N-/)
  "$HOME/.rd/bin"(N-/)
  "$HOME/.config/emacs/bin"(N-/)
  "$HOME/.nix-profile/bin"(N-/)
  /run/current-system/sw/bin(N-/)
  /nix/var/nix/profiles/default/bin(N-/)
  $path
  "$HOME/.pixi/bin"(N-/)
  "/Applications/Obsidian.app/Contents/MacOS"(N-/)
)

export MANPATH="$HOME/.local/share/man:${MANPATH:-}"

GPG_TTY=$(tty 2>/dev/null) && export GPG_TTY

# --- completions ------------------------------------------------------------

# Nix packages' completions arrive on fpath already, via the
# /run/current-system/sw entry that /etc/zshenv adds. This is for the rest.
fpath=("$XDG_DATA_HOME/zsh/site-functions"(N-/) $fpath)

autoload -Uz compinit
# Only rebuild the dump if it's more than a day old.
if [[ -n ~/.zcompdump(N.mh+24) ]]; then
  compinit
else
  compinit -C
fi
autoload -U +X bashcompinit && bashcompinit

# --- ssh agent --------------------------------------------------------------

# Keep a forwarded agent when SSH'd in; otherwise let keychain manage a local one.
use_forwarded_agent=0
if [[ -n "$SSH_CONNECTION" && "$SSH_AUTH_SOCK" == /tmp/ssh-*/agent.* ]]; then
  ssh-add -l >/dev/null 2>&1
  (( $? == 0 || $? == 1 )) && use_forwarded_agent=1
fi
if (( ! use_forwarded_agent )) && (( $+commands[keychain] )); then
  eval "$(keychain --eval --quiet --ignore-missing id_ed25519)" || true
fi
unset use_forwarded_agent

# --- tool integrations ------------------------------------------------------

(( $+commands[direnv] )) && eval "$(direnv hook zsh)"
(( $+commands[pixi] )) && eval "$(pixi completion --shell zsh)"

# mise supplies node, python, go and every global CLI tool — see
# ~/.config/mise/config.toml. Anything below this line may depend on it;
# nothing above it can, which is why GOPATH is set in .zshenv.
(( $+commands[mise] )) && eval "$(mise activate zsh)"

if (( $+commands[micromamba] )); then
  export MAMBA_EXE="$commands[micromamba]"
  eval "$("$MAMBA_EXE" shell hook --shell zsh --root-prefix "$MAMBA_ROOT_PREFIX")"
fi

if (( $+commands[fzf] )); then
  source <(fzf --zsh)
  if (( $+commands[fd] )); then
    export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  fi
fi

# --- aliases and functions --------------------------------------------------

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

(( $+commands[bun] )) && alias bunx='bun x'
(( $+commands[docker] )) && alias d='docker'
(( $+commands[rails] )) && alias r='rails'
(( $+commands[opencode] )) && alias c='opencode'
(( $+commands[tmux] )) && alias t='tmux attach || tmux new -s Work'
(( $+commands[emacsclient] )) && alias emacs='emacsclient --no-window-system --alternate-editor=""'
(( $+commands[claude] )) && alias cx='printf "\033[2J\033[3J\033[H" && claude --allow-dangerously-skip-permissions'

if (( $+commands[eza] )); then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi

if (( $+commands[fzf] && $+commands[bat] )); then
  alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
  alias eff='${EDITOR:-nvim} "$(ff)"'
fi

if (( $+commands[git] )); then
  alias g='git'
  alias gcm='git commit -m'
  alias gcam='git commit -a -m'
  alias gcad='git commit -a --amend'
fi

n() {
  if (( $# == 0 )); then
    command nvim .
  else
    command nvim "$@"
  fi
}

create_direnv_micromamba() {
  local env_name=${1:-${PWD:t}}
  echo "layout micromamba $env_name" >.envrc
  direnv allow .
}

create_direnv_venv() {
  echo "source .venv/bin/activate" >.envrc
  direnv allow .
}

jupyter_remote_load_env() {
  local env_file=${1:-$JUPYTER_REMOTE_ENV_FILE}
  if [[ ! -f "$env_file" ]]; then
    print -u2 "Missing Jupyter env file: $env_file"
    return 1
  fi
  source "$env_file"
}

# --- local overrides --------------------------------------------------------

[[ -f "$XDG_CONFIG_HOME/shell/extras.sh" ]] && source "$XDG_CONFIG_HOME/shell/extras.sh"

# --- prompt (must stay last) ------------------------------------------------

(( $+commands[starship] )) && eval "$(starship init zsh)"
(( $+commands[zoxide] )) && eval "$(zoxide init --cmd cd zsh)"
(( $+commands[atuin] )) && eval "$(atuin init zsh)"
