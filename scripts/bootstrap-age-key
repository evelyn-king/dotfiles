#!/bin/sh
set -eu

usage() {
  cat >&2 <<'USAGE'
usage:
  scripts/bootstrap-age-key [--generate] [key-file]

Import an existing age identity from key-file or stdin into the chezmoi key
path. With --generate, create a new identity with age-keygen instead.

Default identity path:
  ~/.config/chezmoi/personal-key.txt

Environment override:
  CHEZMOI_AGE_IDENTITY
USAGE
}

generate=0
if [ "${1:-}" = "--generate" ]; then
  generate=1
  shift
fi

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
esac

if [ $# -gt 1 ]; then
  usage
  exit 2
fi

identity="${CHEZMOI_AGE_IDENTITY:-$HOME/.config/chezmoi/personal-key.txt}"
source_file="${1:-}"

if [ -e "$identity" ]; then
  printf 'age identity already exists: %s\n' "$identity" >&2
  exit 1
fi

mkdir -p "$(dirname "$identity")"

tmp="${identity}.tmp.$$"
trap 'rm -f "$tmp"' EXIT HUP INT TERM

if [ "$generate" -eq 1 ]; then
  if [ -n "$source_file" ]; then
    printf '%s\n' '--generate does not accept a key-file argument' >&2
    exit 2
  fi
  if ! command -v age-keygen >/dev/null 2>&1; then
    printf 'missing required command for --generate: age-keygen\n' >&2
    exit 1
  fi
  umask 077
  age-keygen -o "$tmp"
elif [ -n "$source_file" ]; then
  if [ ! -r "$source_file" ]; then
    printf 'cannot read key file: %s\n' "$source_file" >&2
    exit 1
  fi
  umask 077
  cat "$source_file" >"$tmp"
else
  if [ -t 0 ]; then
    usage
    exit 2
  fi
  umask 077
  cat >"$tmp"
fi

if ! grep -q '^AGE-SECRET-KEY-' "$tmp"; then
  printf 'input does not look like an age identity file\n' >&2
  exit 1
fi

chmod 600 "$tmp"
mv "$tmp" "$identity"
trap - EXIT HUP INT TERM

printf 'Installed age identity: %s\n' "$identity"

if command -v age-keygen >/dev/null 2>&1; then
  recipient=$(age-keygen -y "$identity" 2>/dev/null || true)
  if [ -n "$recipient" ]; then
    printf 'Recipient: %s\n' "$recipient"
    printf '\nIf this differs from the recipient in .chezmoi.toml.tmpl, commit the\n'
    printf 'new public recipient there and re-encrypt the encrypted files.\n'
  fi
else
  printf 'Install age-keygen to print the public recipient for this identity.\n'
fi
