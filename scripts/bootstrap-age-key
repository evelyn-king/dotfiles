#!/bin/sh
set -eu

usage() {
  cat >&2 <<'EOF'
usage:
  scripts/bootstrap-age-key [--generate] [key-file]

Import an existing age identity from key-file or stdin into the chezmoi key
path. With --generate, create a new identity with age-keygen.

Default key path: ~/.config/chezmoi/key.txt
Override with CHEZMOI_AGE_IDENTITY.
EOF
}

generate=0
if [ "${1:-}" = "--generate" ]; then
  generate=1
  shift
fi

if [ $# -gt 1 ]; then
  usage
  exit 2
fi

identity="${CHEZMOI_AGE_IDENTITY:-$HOME/.config/chezmoi/key.txt}"
source_file="${1:-}"

if [ -e "$identity" ]; then
  printf 'age identity already exists: %s\n' "$identity" >&2
  exit 1
fi

mkdir -p "$(dirname "$identity")"

tmp="${identity}.tmp.$$"
trap 'rm -f "$tmp"' EXIT HUP INT TERM
umask 077

if [ "$generate" -eq 1 ]; then
  if [ -n "$source_file" ]; then
    printf '%s\n' '--generate does not accept a key-file argument' >&2
    exit 2
  fi
  if ! command -v age-keygen >/dev/null 2>&1; then
    printf 'missing required command for --generate: age-keygen\n' >&2
    exit 1
  fi
  age-keygen -o "$tmp"
elif [ -n "$source_file" ]; then
  if [ ! -r "$source_file" ]; then
    printf 'cannot read key file: %s\n' "$source_file" >&2
    exit 1
  fi
  cat "$source_file" >"$tmp"
elif [ -t 0 ]; then
  usage
  exit 2
else
  cat >"$tmp"
fi

if ! grep -q '^AGE-SECRET-KEY-' "$tmp"; then
  printf 'input does not look like an age identity file\n' >&2
  exit 1
fi

chmod 600 "$tmp"
mv "$tmp" "$identity"
trap - EXIT HUP INT TERM

printf 'Installed age identity: %s\n' "$identity"

if command -v age-keygen >/dev/null 2>&1; then
  recipient=$(age-keygen -y "$identity" 2>/dev/null || true)
  [ -n "$recipient" ] && printf 'Recipient: %s\n' "$recipient"
fi
