#!/usr/bin/env bash

# Install the mise release pinned in .chezmoidata/versions.yaml into
# ~/.local/bin on every supported host.
#
# One mise version everywhere keeps `mup` lock refreshes consistent no matter
# which host runs them. Every apply checks the installed version, which costs
# one `mise --version`, so a deleted or force-updated binary is restored.
# Omarchy's `mise-bin` package stays installed for Omarchy's own scripts;
# ~/.local/bin precedes /usr/bin on the managed PATH.
{{- $platform := "" }}
{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") }}
{{-   $platform = "macos-arm64" }}
{{- else if and (eq .chezmoi.os "linux") (eq .chezmoi.arch "amd64") }}
{{-   $platform = "linux-x64" }}
{{- end }}

set -euo pipefail

{{ if not $platform -}}
echo "mise: no pinned release for {{ .chezmoi.os }}/{{ .chezmoi.arch }}; skipping installation." >&2
exit 0
{{- else -}}
version={{ .mise.version | quote }}
sha256={{ index .mise.sha256 $platform | quote }}
archive="mise-v$version-{{ $platform }}.tar.gz"

prefix="$HOME/.local"
mise="$prefix/bin/mise"
data="${XDG_DATA_HOME:-$HOME/.local/share}"

# Shipping update instructions disables `mise self-update` and tells anyone who
# runs it where the version actually lives. mise looks for this file relative
# to its own install prefix.
write_update_instructions() {
  mkdir -p "$prefix/lib/mise"
  cat >"$prefix/lib/mise/mise-self-update-instructions.toml" <<'EOF'
message = "The dotfiles pin this mise release. To update it, change mise.version and both checksums in .chezmoidata/versions.yaml, then run `chezmoi apply` on each host.\n"
EOF
}

write_completions() {
  mkdir -p "$data/zsh/site-functions" "$data/bash-completion/completions"
  "$mise" completion zsh >"$data/zsh/site-functions/_mise"
  "$mise" completion bash >"$data/bash-completion/completions/mise"
}

installed=$("$mise" --version 2>/dev/null || true)
if [ "${installed%% *}" = "$version" ]; then
  write_update_instructions
  [ -s "$data/zsh/site-functions/_mise" ] || write_completions
  exit 0
fi

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum -- "$1" | awk '{ print $1 }'
  else
    shasum -a 256 -- "$1" | awk '{ print $1 }'
  fi
}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

echo "mise: installing $version into $prefix/bin"
curl --proto '=https' --tlsv1.2 -fsSL -o "$work/$archive" \
  "https://github.com/jdx/mise/releases/download/v$version/$archive"
actual=$(sha256_of "$work/$archive")
if [ "$actual" != "$sha256" ]; then
  echo "mise: checksum mismatch for $archive (expected $sha256, got $actual)." >&2
  exit 1
fi
tar -xzf "$work/$archive" -C "$work"

# Install beside the target and rename, so a running mise is never truncated.
mkdir -p "$prefix/bin" "$data/man/man1"
install -m 0755 "$work/mise/bin/mise" "$mise.new"
mv -f "$mise.new" "$mise"
install -m 0644 "$work/mise/man/man1/mise.1" "$data/man/man1/mise.1"
write_update_instructions
write_completions
{{- end }}
