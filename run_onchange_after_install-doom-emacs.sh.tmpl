#!/usr/bin/env bash

# Keep Doom's checkout pinned, then install or sync it against the managed
# config. `doom install` is idempotent and performs the required sync.
#
# Executable paths are part of the rendered script so installing either
# dependency after an initial apply causes chezmoi to retry this hook.
# git executable: {{ lookPath "git" | quote }}
# Emacs executable: {{ lookPath "emacs" | quote }}
# Doom rev: {{ .doom.rev }}
# config.el hash: {{ include "dot_config/doom/config.el" | sha256sum }}
# init.el hash: {{ include "dot_config/doom/init.el" | sha256sum }}
# packages.el hash: {{ include "dot_config/doom/packages.el" | sha256sum }}

set -euo pipefail

if ! command -v git >/dev/null 2>&1; then
  echo "Git is not installed; skipping Doom Emacs setup."
  exit 0
fi
if ! command -v emacs >/dev/null 2>&1; then
  echo "Emacs is not installed; skipping Doom Emacs setup."
  exit 0
fi

repo={{ .doom.repo | quote }}
rev={{ .doom.rev | quote }}
dest="$HOME/.config/emacs"
stage="$HOME/.config/emacs.chezmoi-install"
stage_marker="$stage/.owner"
stage_owner="chezmoi Doom checkout staging directory for $dest"

remove_stage() {
  if [ -f "$stage_marker" ] && [ "$(<"$stage_marker")" = "$stage_owner" ]; then
    rm -rf -- "$stage"
  fi
}

if [ -e "$stage" ]; then
  if [ ! -f "$stage_marker" ] || [ "$(<"$stage_marker")" != "$stage_owner" ]; then
    echo "doom: $stage exists but is not owned by this installer." >&2
    exit 1
  fi
  echo "doom: removing an interrupted staged checkout"
  remove_stage
fi

if [ ! -d "$dest/.git" ]; then
  if [ -e "$dest" ]; then
    echo "doom: $dest exists but is not a git checkout." >&2
    exit 1
  fi

  mkdir -m 700 "$stage"
  printf '%s\n' "$stage_owner" >"$stage_marker"
  trap remove_stage EXIT
  trap 'exit 1' HUP INT TERM

  echo "doom: cloning $repo"
  git clone --filter=blob:none "$repo" "$stage/checkout"
  git -C "$stage/checkout" fetch --quiet origin "$rev" 2>/dev/null ||
    git -C "$stage/checkout" fetch --quiet origin
  git -C "$stage/checkout" checkout --quiet --detach "$rev"

  if ! git -C "$stage/checkout" rev-parse --verify HEAD >/dev/null 2>&1 ||
    [ "$(git -C "$stage/checkout" remote get-url origin 2>/dev/null || true)" != "$repo" ] ||
    [ ! -x "$stage/checkout/bin/doom" ]; then
    echo "doom: staged checkout failed validation; not installing it." >&2
    exit 1
  fi

  mv "$stage/checkout" "$dest"
  rm "$stage_marker"
  rmdir "$stage"
  trap - EXIT HUP INT TERM
fi

if ! current_rev=$(git -C "$dest" rev-parse --verify HEAD 2>/dev/null); then
  echo "doom: $dest has an invalid Git checkout; move it aside after checking for user data, then apply again." >&2
  exit 1
fi

if [ "$(git -C "$dest" remote get-url origin 2>/dev/null || true)" != "$repo" ]; then
  echo "doom: $dest has an unexpected origin; not modifying it." >&2
  exit 1
fi

if [ "$current_rev" != "$rev" ]; then
  # Moving the checkout must not discard local work. Returning failure keeps
  # this hook pending so a later apply retries after the checkout is clean.
  if [ -n "$(git -C "$dest" status --porcelain 2>/dev/null)" ]; then
    echo "doom: $dest has uncommitted changes; not moving it to $rev." >&2
    exit 1
  fi

  echo "doom: checking out $rev"
  git -C "$dest" fetch --quiet origin "$rev" 2>/dev/null ||
    git -C "$dest" fetch --quiet origin
  git -C "$dest" checkout --quiet --detach "$rev"
fi

if [ ! -x "$dest/bin/doom" ]; then
  echo "doom: $dest/bin/doom is missing or not executable." >&2
  exit 1
fi

echo "doom: installing packages and syncing config"
"$dest/bin/doom" install --aot --no-config --env
