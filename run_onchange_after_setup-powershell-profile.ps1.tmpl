# Mirror the managed profile to Windows PowerShell and PowerShell 7.
#
# Ask each installed shell for its profile path to honor redirected Documents
# folders. The two editions use different profile directories. Re-runs whenever
# the managed copy below changes.

# source hash: {{ include "dot_config/powershell/Microsoft.PowerShell_profile.ps1" | sha256sum }}

$ErrorActionPreference = 'Stop'

$source = '{{ joinPath .chezmoi.homeDir ".config/powershell/Microsoft.PowerShell_profile.ps1" | replace "'" "''" }}'
$targets = @($PROFILE.CurrentUserCurrentHost)
foreach ($shell in @('powershell.exe', 'pwsh.exe')) {
    # PATH can hold more than one copy, such as a Store package's install
    # directory next to its WindowsApps execution alias. Store packages may
    # refuse to launch from the install directory, so try each until one
    # answers.
    $candidates = @(Get-Command $shell -CommandType Application -All -ErrorAction SilentlyContinue |
        Select-Object -ExpandProperty Source -Unique)
    if ($candidates.Count -eq 0) {
        continue
    }
    $target = $null
    foreach ($candidate in $candidates) {
        try {
            $output = & $candidate -NoLogo -NoProfile -NonInteractive -Command '$PROFILE.CurrentUserCurrentHost' 2>$null
            if ($LASTEXITCODE -eq 0 -and $output) {
                $target = ($output | Out-String).Trim()
                break
            }
        }
        catch {
            continue
        }
    }
    if (-not $target) {
        throw "Could not determine the profile path for $shell (tried: $($candidates -join ', '))."
    }
    $targets += $target
}

foreach ($target in ($targets | Select-Object -Unique)) {
    $targetDir = Split-Path -Parent $target
    if (-not (Test-Path -LiteralPath $targetDir)) {
        New-Item -ItemType Directory -Path $targetDir -Force | Out-Null
    }
    Copy-Item -LiteralPath $source -Destination $target -Force
}
