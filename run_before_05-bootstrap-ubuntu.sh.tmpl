#!/usr/bin/env bash

# Restore native dependencies before writing configs or installing tools.
{{- $ubuntu := includeTemplate "ubuntu-detect.tmpl" . }}
set -euo pipefail

{{ if $ubuntu -}}
{{ if or (ne (.chezmoi.osRelease.versionID | default "") "26.04") (ne .chezmoi.arch "amd64") -}}
echo "dotfiles: Ubuntu support requires Ubuntu 26.04 on x86_64." >&2
exit 1
{{ else -}}
# run_before_00-install-mise installs the pinned release here.
mise="$HOME/.local/bin/mise"
if [ ! -x "$mise" ]; then
  echo "dotfiles: $mise is missing; the mise install hook should have provided it." >&2
  exit 1
fi
if ! "$mise" bootstrap files apply --help >/dev/null 2>&1; then
  echo "dotfiles: the pinned mise release lacks system-file bootstrap; raise the mise pin in .chezmoidata/versions.yaml." >&2
  exit 1
fi

# Keep project-local mise declarations out of system package restoration.
export MISE_CONFIG_DIR={{ joinPath .chezmoi.sourceDir "dot_config/mise" | quote }}
MISE_SYSTEM_PACKAGES_MANAGERS=apt "$mise" --cd / bootstrap --only files,packages --yes
{{ end -}}
{{ else -}}
exit 0
{{ end -}}
