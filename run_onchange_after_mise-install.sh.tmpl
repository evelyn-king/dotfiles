#!/usr/bin/env bash

# Install the runtimes and global CLI tools declared in
# ~/.config/mise/conf.d/10-dotfiles.toml.
#
# Re-runs whenever that file changes, so adding a tool is a one-line edit plus
# `chezmoi apply` rather than a remembered command. This replaces the old
# sync-uv and sync-bun scripts, which had to be run by hand and had drifted
# from what was actually installed.
#
# tool list hash: {{ include "dot_config/mise/conf.d/10-dotfiles.toml" | sha256sum }}

set -euo pipefail

# mise is yours to install; on a machine without it there is nothing to do.
command -v mise >/dev/null 2>&1 || exit 0

# The npm: backend is configured to use bun, and pipx: uses uv when present.
# Without them mise falls back to slower defaults rather than failing, so this
# is a warning and not an exit.
for backend in bun uv; do
  command -v "$backend" >/dev/null 2>&1 ||
    echo "mise: $backend not on PATH; backend installs will use a fallback." >&2
done

mise install
