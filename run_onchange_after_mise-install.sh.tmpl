#!/usr/bin/env bash

# Install the runtimes and global CLI tools declared in the mise conf.d files.
#
# Re-runs whenever those files or the lock change. Refresh the shared lock after
# editing a tool declaration, then apply.

{{ template "mise-config-hashes.tmpl" . }}
# lock hash: {{ include "dot_config/mise/mise.lock" | sha256sum }}
# mise version: {{ .mise.version }}

set -euo pipefail

# run_before_00-install-mise installs the pinned release here. Call it by path:
# the apply's PATH may predate ~/.local/bin, and Omarchy's /usr/bin/mise is a
# different release. A host without a pinned release has nothing to do.
mise="$HOME/.local/bin/mise"
[ -x "$mise" ] || exit 0

# Read the managed tool declarations and the committed lock from the source
# tree. Every declared tool is installed on all supported hosts.
MISE_CONFIG_DIR={{ printf "%s/dot_config/mise" .chezmoi.sourceDir | quote }}
export MISE_CONFIG_DIR

# The lockfile is repo content and is never applied to $HOME, so the locked
# install reads it from the source tree, which is also what `mup` does.
# mise orders the declared bun/uv installers before their dependent tools.
# Use only the tools phase: chezmoi owns files and shell activation, and the
# Ubuntu before-hook has already restored apt packages.
"$mise" --cd / bootstrap --only tools --locked
