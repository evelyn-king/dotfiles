" .vimrc - Evelyn King

set nocompatible
filetype plugin indent on
syntax enable
set backspace=indent,eol,start
set encoding=utf-8

set hidden
set mouse=a

set number
set relativenumber
set signcolumn=yes
set ruler
set cursorline

set nohlsearch
set incsearch
set ignorecase
set splitbelow
set splitright

set tabstop=2
set softtabstop=2
set shiftwidth=2
set expandtab
set smartcase

set scrolloff=4
set sidescrolloff=8
set wildmode=longest:full,full
set updatetime=250

if exists('+termguicolors')
  set termguicolors
endif

if exists('+clipboard')
  set clipboard+=unnamedplus
endif

if exists('+undofile')
  set undofile
endif

set undodir=~/.vim/undo-dir
set undofile

inoremap jk <Esc>

set background=dark
colorscheme gruvbox
let g:airline_theme = 'gruvbox'
