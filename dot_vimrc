" .vimrc - Evelyn King

set nocompatible
filetype plugin indent on
syntax enable
set backspace=indent,eol,start
set encoding=utf-8

set hidden
set mouse=a

set number
set relativenumber
set signcolumn=yes
set ruler
set cursorline

" Neovim leaves hlsearch on, and <Esc> / <leader>ur in
" ~/.vim/plugin/keymaps.vim exist to clear it. Keep the two in step.
set hlsearch
set incsearch
set ignorecase
set splitbelow
set splitright

set tabstop=2
set softtabstop=2
set shiftwidth=2
set expandtab
set smartcase

set scrolloff=4
set sidescrolloff=8
set wildmenu
set wildmode=longest:full,full
set updatetime=250

" LazyVim's timeoutlen, so leader chords feel the same in both editors. The
" short ttimeoutlen keeps <Esc> responsive despite the normal-mode <Esc>
" mapping and the <M-j>/<M-k> terminal key codes in keymaps.vim.
set timeoutlen=300
set ttimeout
set ttimeoutlen=10

" Backing for the picker-key fallbacks in ~/.vim/plugin/keymaps.vim. Plain
" wildmenu completion, not a fuzzy finder, but the keys land somewhere useful.
set path+=**
if executable('rg')
  set grepprg=rg\ --vimgrep\ --smart-case
  set grepformat=%f:%l:%c:%m
endif

augroup vimrc_grep
  autocmd!
  autocmd QuickFixCmdPost grep,grepadd,vimgrep cwindow
augroup END

if exists('+termguicolors')
  set termguicolors
endif

if exists('+clipboard')
  set clipboard+=unnamedplus
endif

if exists('+undofile')
  set undofile
endif

set undodir=~/.vim/undo-dir

" Mappings live in ~/.vim/plugin/keymaps.vim, the counterpart to Neovim's
" lua/config/keymaps.lua. The leader and the plugin mapping flags belong here
" instead: both are read when the pack plugins load, after this file.
let mapleader = ' '
let maplocalleader = '\'

" NERDCommenter's defaults claim <leader>c*, which is Neovim's code prefix.
" keymaps.vim maps its <Plug> targets onto gc* instead.
let g:NERDCreateDefaultMappings = 0

set background=dark
colorscheme gruvbox
let g:airline_theme = 'gruvbox'
