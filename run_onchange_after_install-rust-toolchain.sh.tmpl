#!/usr/bin/env bash

# Give the Nix `rustup` a toolchain to point at.
#
# rustup ships no toolchain of its own: a machine that has `rustup` and `cargo`
# on PATH still fails every invocation until a default is installed. This does
# not install rustup — that is yours — it only gives an existing one something
# to point at. Note that dot_cargo/config.toml sets rustc-wrapper = "sccache",
# so sccache needs to be on PATH too or cargo will fail.
#
# Script version: 2026-08-17-rust-default-toolchain

set -euo pipefail

command -v rustup >/dev/null 2>&1 || exit 0

if rustup show active-toolchain >/dev/null 2>&1; then
  exit 0
fi

echo "rustup: no default toolchain; installing stable."
rustup default stable
